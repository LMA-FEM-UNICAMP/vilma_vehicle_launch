<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- load parameter -->
  <xacro:property name="vehicle_info" value="${xacro.load_yaml('$(find vilma_vehicle_description)/config/vehicle_info.param.yaml')}"/>

  <!-- vehicle body -->
  <link name="base_link">
    <visual>
      <origin xyz="${vehicle_info['/**']['ros__parameters']['wheel_base']/2.0} 0 0" rpy="${pi/2.0} 0 ${pi}"/> 
      <geometry>
        <mesh filename="package://vilma_vehicle_description/mesh/punto/model_base_link_origin.dae" scale="0.7133 0.7133 0.7133"/>
      </geometry>


      <!-- <origin xyz="${vehicle_info['/**']['ros__parameters']['wheel_base']/2.0 + 0.77} 0 -${vehicle_info['/**']['ros__parameters']['wheel_radius']/2.0}" rpy="${pi/2.0} 0 ${pi}"/> 
      <geometry>
        <mesh filename="package://vilma_vehicle_description/mesh/punto/model.dae" scale="1 1 1"/>
      </geometry> -->
    </visual>
  </link>
</robot>