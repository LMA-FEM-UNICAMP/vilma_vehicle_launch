<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="hmi" default="vilma_autoware" description="options: vilma_autoware, vilma_autoware_steer_only"/>
    <include file="$(find-pkg-share vilma_interface)/launch/vilma_interface.launch.py">
    </include>
    <include file="$(find-pkg-share vilma_hmi)/launch/vilma_hmi.launch.py">
      <arg name="hmi" value="$(var hmi)"/>
    </include>
</launch>
